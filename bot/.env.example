# Copy to .env (never commit it). Used when you run the review dashboard on your laptop.
# GitHub Actions gets the same values from the repo's Secrets (see README).

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxx.supabase.co
# The SERVICE ROLE key: full access. Keep it secret, laptop only.
SUPABASE_SERVICE_KEY=eyJ...

# --- AI drafts: any OpenAI-compatible API ---
# OpenRouter (default):
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4o-mini
# For OpenAI directly instead:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Original artwork for every article ---
# openrouter (default when LLM_API_KEY is set) | openai | none (free procedural art only)
IMAGE_PROVIDER=openrouter
# OpenRouter: google/gemini-2.5-flash-image (cheap), openai/gpt-image-1, black-forest-labs/flux.2-pro
# OpenAI:     gpt-image-1
IMAGE_MODEL=google/gemini-2.5-flash-image
# Optional: a different key for images (defaults to LLM_API_KEY)
IMAGE_API_KEY=

# --- Site ---
SITE_NAME=anime.support
SITE_URL=https://anime.support

# --- Deploy (only used by the laptop dashboard's "Deploy now" button) ---
# GitHub Actions runs the bot on its own and deploys after each run. On the laptop:
# "git"      = commit + push a marker file; the push starts the Deploy workflow (default)
# "dispatch" = no git needed: start the Deploy workflow through GitHub's API
DEPLOY_MODE=git
# Path to your local clone of the repo (the folder that contains /site and /bot)
REPO_DIR=..
GIT_BRANCH=main
GITHUB_REPO=Matanza00/anime.support
# For DEPLOY_MODE=dispatch: fine-grained token with "Actions: Read and write" on this repo
GITHUB_DISPATCH_TOKEN=

# --- Facebook page auto-posting (optional; leave empty to skip) ---
FB_PAGE_ID=
FB_PAGE_TOKEN=
# photo = branded headline card as a photo post (link in caption) | link = link preview post
FB_POST_MODE=photo
# Minutes to wait after publishing before posting, so the page is live first
FB_DELAY_MINUTES=10

# --- Review dashboard (open from your phone on the same Wi-Fi) ---
REVIEW_PORT=4000
REVIEW_PASSWORD=change-this-password

# --- Schedules (cron syntax, your laptop's local time) ---
COLLECT_CRON=5 * * * *
# Every 2 hours keeps you under Cloudflare Pages free limit (500 builds/month).
# For breaking news, tap "Deploy now" in the dashboard.
PUBLISH_CRON=0 */2 * * *
OPTIMIZE_CRON=0 3 * * 0
# Max new drafts per hourly run (controls AI cost and your review load)
MAX_DRAFTS_PER_RUN=6
# Only consider headlines newer than this
MAX_ITEM_AGE_HOURS=48
# true = weekly optimizer disables sources outside the top 3 per tier
SOURCES_AUTO_PRUNE=false
