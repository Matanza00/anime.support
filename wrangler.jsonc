// Cloudflare Worker: static site (web/out) + tiny /api for view counts, with the D1 database.
// Deployed by .github/workflows/deploy.yml. database_id is filled in at deploy time by database/setup.mjs.
{
  "name": "anime-support",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "anime-support", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  // Starts the GitHub bot on time: every 2 h (news), daily (anime catalog), weekly (optimizer). Times are UTC.
  "triggers": { "crons": ["17 */2 * * *", "41 1 * * *", "23 22 * * 0"] },
  // Requires anime.support to be in the same Cloudflare account (it is).
  "routes": [
    { "pattern": "anime.support", "custom_domain": true },
    { "pattern": "www.anime.support", "custom_domain": true }
  ]
}
