---
// Shows the article's image when it has one; otherwise a colour cover generated from the anime name.
import { hueFor } from '../lib/site.js';
const { label = '', image = '', credit = '', large = false, eager = false } = Astro.props;
---
{image ? (
  <div class:list={['cover', 'has-img', { lg: large }]} style={`--h:${hueFor(label)}`}>
    <img src={image} alt={label} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    {credit && <small class="credit">{credit}</small>}
  </div>
) : (
  <div class:list={['cover', { lg: large }]} style={`--h:${hueFor(label)}`} aria-hidden="true">
    <b>{label}</b>
  </div>
)}
