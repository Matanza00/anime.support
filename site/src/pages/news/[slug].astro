---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import Card from '../../components/Card.astro';
import AdSlot from '../../components/AdSlot.astro';
import { allArticles, related } from '../../lib/db.js';
import { renderArticle } from '../../lib/markdown.js';
import { renderMediaList } from '../../lib/embeds.js';
import { SITE, CATEGORY_LABEL, formatDate, readingTime, slugify } from '../../lib/site.js';

export async function getStaticPaths() {
  return (await allArticles()).map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article: a } = Astro.props;
const scripts = new Set();
const { before, after } = renderArticle(a.body_md, scripts);
const mediaHtml = renderMediaList(a.media ?? [], scripts);
const more = await related(a);
const url = `${SITE.url}/news/${a.slug}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: a.title,
  description: a.excerpt,
  datePublished: a.published_at,
  dateModified: a.updated_at ?? a.published_at,
  mainEntityOfPage: url,
  author: { '@type': 'Organization', name: `${SITE.name} Newsroom`, url: `${SITE.url}/about` },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url, logo: { '@type': 'ImageObject', url: `${SITE.url}/brand/logo.png` } },
  about: (a.anime ?? []).map((name) => ({ '@type': 'CreativeWork', name })),
  ...(a.cover_url ? { image: [new URL(a.cover_url, SITE.url + '/').toString()] } : {}),
};
---
<Base title={a.title} description={a.excerpt} type="article" jsonLd={jsonLd} image={a.cover_url}>
  <article class="article">
    <span class:list={['kicker', a.category]}>{CATEGORY_LABEL[a.category]}</span>
    <h1>{a.title}</h1>
    <p class="dek">{a.excerpt}</p>
    <div class="meta">
      <span>{SITE.name} Newsroom</span>
      <time datetime={a.published_at}>{formatDate(a.published_at)}</time>
      <span>{readingTime(a.body_md)} min read</span>
    </div>
    {a.anime?.length > 0 && (
      <div class="chips" style="margin-top:14px">
        {a.anime.map((name) => <a class="chip" href={`/anime/${slugify(name)}`}>{name}</a>)}
      </div>
    )}

    <Cover label={a.anime?.[0] ?? CATEGORY_LABEL[a.category]} image={a.cover_url} credit={a.cover_credit} large eager />
    <AdSlot slot="top" />

    <div class="prose" set:html={before} />
    {mediaHtml && <div class="media-block" set:html={mediaHtml} />}
    {after && <AdSlot slot="inArticle" />}
    {after && <div class="prose" style="margin-top:1.1em" set:html={after} />}

    {a.source_urls?.length > 0 && (
      <aside class="sources">
        <strong>Sources.</strong> This story is based on reporting and official announcements from{' '}
        {a.source_urls.map((href, i) => (
          <>
            <a href={href} rel="noopener nofollow" target="_blank">{a.source_names?.[i] ?? new URL(href).hostname}</a>
            {i < a.source_urls.length - 1 ? ', ' : '.'}
          </>
        ))}{' '}
        Spotted an error? <a href="/contact">Tell us</a> and we will correct it.
      </aside>
    )}

    <AdSlot slot="bottom" />
  </article>

  {more.length > 0 && (
    <section class="wrap section">
      <div class="section-head"><h2>More on {a.anime?.[0]}</h2></div>
      <div class="grid">{more.map((r) => <Card article={r} />)}</div>
    </section>
  )}

  {[...scripts].map((src) => <script async src={src} is:inline></script>)}
  <script is:inline>
    // YouTube facade: swap the thumbnail for the real player when tapped.
    document.querySelectorAll('.yt').forEach((el) => {
      el.addEventListener('click', () => {
        const f = document.createElement('iframe');
        f.src = 'https://www.youtube-nocookie.com/embed/' + el.dataset.yt + '?autoplay=1&rel=0';
        f.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
        f.allowFullscreen = true;
        f.title = 'YouTube video';
        el.replaceChildren(f);
      }, { once: true });
    });
  </script>

  <script is:inline define:vars={{ slug: a.slug, base: SITE.supabaseUrl, key: SITE.supabaseAnon }}>
    // Counts one view per article per browser session (feeds the optimizer).
    try {
      const k = 'v:' + slug;
      if (base && key && !sessionStorage.getItem(k)) {
        sessionStorage.setItem(k, '1');
        fetch(base + '/rest/v1/rpc/increment_view', {
          method: 'POST',
          headers: { apikey: key, Authorization: 'Bearer ' + key, 'Content-Type': 'application/json' },
          body: JSON.stringify({ p_slug: slug }),
          keepalive: true,
        }).catch(() => {});
      }
    } catch (e) {}
  </script>
</Base>
