---
// One evergreen hub per anime: "everything confirmed so far". These pages keep
// ranking long after individual news posts go stale, so they update on every build.
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Cover from '../../components/Cover.astro';
import AdSlot from '../../components/AdSlot.astro';
import { animeHubs } from '../../lib/db.js';
import { SITE, formatDate } from '../../lib/site.js';

export async function getStaticPaths() {
  return (await animeHubs()).map((hub) => ({ params: { tag: hub.slug }, props: { hub } }));
}

const { hub } = Astro.props;
const withImage = hub.articles.find((a) => a.cover_url);
const upcoming = hub.articles.filter((a) => a.category === 'upcoming' || a.category === 'release');
const title = `${hub.name}: latest news, release dates and everything confirmed`;
const description = `Everything officially confirmed about ${hub.name}: new seasons, release dates, cast and story news, updated ${formatDate(hub.latest)}.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: `${SITE.url}/anime/${hub.slug}`,
};
---
<Base title={title} description={description} jsonLd={jsonLd} image={withImage?.cover_url}>
  <div class="wrap section">
    <Cover label={hub.name} image={withImage?.cover_url} credit={withImage?.cover_credit} large eager />
    <h1 style="font-size:clamp(30px,5vw,46px);margin:22px 0 10px">{hub.name}: everything confirmed so far</h1>
    <p style="color:var(--muted)">{hub.count} stories · last updated {formatDate(hub.latest)}</p>

    <AdSlot slot="top" />

    {upcoming.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>What's coming next</h2></div>
        <div class="grid">{upcoming.map((a) => <Card article={a} />)}</div>
      </section>
    )}

    <section class="section">
      <div class="section-head"><h2>All {hub.name} news</h2></div>
      <div class="grid">{hub.articles.map((a) => <Card article={a} />)}</div>
    </section>
  </div>
</Base>
