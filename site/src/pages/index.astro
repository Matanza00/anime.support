---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Cover from '../components/Cover.astro';
import AdSlot from '../components/AdSlot.astro';
import { allArticles, trending, byCategory, animeHubs } from '../lib/db.js';
import { SITE, CATEGORY_LABEL, formatDate } from '../lib/site.js';

const all = await allArticles();
const [top, ...rest] = all;
const hot = await trending(5);
const upcoming = await byCategory(['upcoming', 'release'], 6);
const hubs = (await animeHubs()).slice(0, 14);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
};
---
<Base jsonLd={jsonLd}>
  <div class="wrap">
    {!top ? (
      <section class="section">
        <div class="empty">
          <h2>No stories yet</h2>
          <p>Approve your first drafts in the review dashboard and they will appear here after the next deploy.</p>
        </div>
      </section>
    ) : (
      <>
        <section class="hero">
          <a class="lead" href={`/news/${top.slug}`}>
            <Cover label={top.anime?.[0] ?? CATEGORY_LABEL[top.category]} image={top.cover_url} credit={top.cover_credit} large eager />
            <span class:list={['kicker', top.category]} style="margin-top:16px">{CATEGORY_LABEL[top.category]}</span>
            <h1>{top.title}</h1>
            <p>{top.excerpt}</p>
          </a>
          <aside>
            <div class="section-head"><h2>Trending</h2></div>
            <div class="side-list">
              {(hot.length ? hot : rest.slice(0, 5)).map((a, i) => (
                <a href={`/news/${a.slug}`}>
                  <span class="n">{i + 1}</span>
                  <div>
                    <h3>{a.title}</h3>
                    <div class="meta">{formatDate(a.published_at)}</div>
                  </div>
                </a>
              ))}
            </div>
          </aside>
        </section>

        <AdSlot slot="top" />

        {hubs.length > 0 && (
          <section class="section">
            <div class="section-head"><h2>Follow your anime</h2><a href="/anime">All anime →</a></div>
            <div class="chips">
              {hubs.map((h) => <a class="chip" href={`/anime/${h.slug}`}>{h.name}</a>)}
            </div>
          </section>
        )}

        <section class="section">
          <div class="section-head"><h2>Latest news</h2><a href="/news">All news →</a></div>
          <div class="grid">{rest.slice(0, 12).map((a) => <Card article={a} />)}</div>
        </section>

        {upcoming.length > 0 && (
          <section class="section">
            <div class="section-head"><h2>Coming soon</h2><a href="/upcoming">Release calendar →</a></div>
            <div class="grid">{upcoming.map((a) => <Card article={a} />)}</div>
          </section>
        )}

        <AdSlot slot="bottom" />
      </>
    )}
  </div>
</Base>
