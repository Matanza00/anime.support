---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import AdSlot from '../components/AdSlot.astro';
import { byCategory } from '../lib/db.js';
const upcoming = await byCategory('upcoming');
const releases = await byCategory('release');
---
<Base
  title="Upcoming anime and new releases"
  description="Confirmed release dates, new seasons, casting and trailers for upcoming anime."
>
  <div class="wrap section">
    <div class="section-head"><h1 style="font-size:40px">Upcoming anime</h1></div>
    <p style="color:var(--muted);max-width:640px;margin-bottom:28px">
      Confirmed seasons, release dates and announcements. We only list what has been officially announced; rumours are labelled as rumours.
    </p>
    <AdSlot slot="top" />
    {upcoming.length ? <div class="grid">{upcoming.map((a) => <Card article={a} />)}</div> : <div class="empty">Nothing announced yet.</div>}
  </div>
  {releases.length > 0 && (
    <div class="wrap section">
      <div class="section-head"><h2>Just released</h2></div>
      <div class="grid">{releases.map((a) => <Card article={a} />)}</div>
    </div>
  )}
</Base>
