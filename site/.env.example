# Copy to .env for local builds. The live build uses site/.env.production.

PUBLIC_SITE_URL=https://anime.support
PUBLIC_SITE_NAME=anime.support
PUBLIC_SITE_TAGLINE=Anime news, release dates and what's coming next
PUBLIC_CONTACT_EMAIL=you@yourdomain.com

# Supabase > Project Settings > API. The anon key is safe to expose publicly;
# row level security only lets it read published articles and count views.
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...

# AdSense. Leave empty until approved; the site works without it.
PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# Optional manual ad unit IDs (Auto Ads works without these)
PUBLIC_ADSENSE_SLOT_TOP=
PUBLIC_ADSENSE_SLOT_INARTICLE=
PUBLIC_ADSENSE_SLOT_BOTTOM=

# Optional: Google Analytics 4 measurement ID
PUBLIC_GA4_ID=
